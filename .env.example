# ==========================================
# 1. Google Cloud (Vertex AI) 인증 설정
# ==========================================
# 다운로드한 서비스 계정 JSON 키 파일 경로를 입력하세요.
# 예: service-account-key.json 또는 C:\keys\gcp-key.json
GOOGLE_APPLICATION_CREDENTIALS=your-service-account-key.json

# ==========================================
# 2. Discord 웹훅 설정
# ==========================================
# 브리핑 메시지를 받을 Discord 채널의 웹훅 URL을 입력하세요.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_channel_id/your_webhook_token

# ==========================================
# 3. 날씨 조회 지역 설정 (선택 · 미입력 시 서울 기본값)
# ==========================================
# 기본값: Seoul / 37.5665 / 126.9780
# 다른 지역으로 바꾸려면 아래 주석을 풀고 원하는 도시명과 위도/경도를 입력하세요.
# WEATHER_CITY=Busan
# WEATHER_LAT=35.1796
# WEATHER_LON=129.0756